PORT=4200
NODE_ENV=development
DATABASE_URL=postgresql://barkie:barkie@localhost:5432/barkie_dev
FRONTEND_ORIGIN=http://localhost:5174
# Path prefix the SPA is served under. Empty in dev (site root); "/app" in
# production's path-based hosting (barkie.co.za/app). See
# docs/superpowers/specs/2026-09-07-frontend-deploy-design.md.
FRONTEND_BASE_PATH=
SESSION_COOKIE_NAME=barkie_session
# Set to true only when running behind a reverse proxy (nginx, Cloudflare, a
# load balancer) that sets X-Forwarded-For. Trusts exactly one hop so
# rate-limiting keys on the real client IP instead of the proxy's IP. Leave
# false for local dev, where there is no proxy in front of the API.
TRUST_PROXY=false
